5:            <h1 class="title-font sm:text-4xl text-3xl mb-4 font-medium text-gray-900">タスク一覧</h1>
6:            <div class="actions flex justify-center mb-6">
7:              <%= link_to "タスク作成", new_task_path, class: 'text-white bg-indigo-500 border-0 py-2 px-6 focus:outline-none hover:bg-indigo-600 rounded text-lg' %>
8:            </div>
9:            <div>
10:              <% @tasks.each do |task| %>
11:                <div style="display: flex;">
12:                  <div style="width: 200px;">Content: <%= task.content %></div>
13:                  <div><%= button_to "edit", edit_task_path(task), method: :get, class= 'text-white bg-green-500 border-0 py-2 px-8 focus:outline-none hover:bg-green-600 rounded text-lg' %></div>
14:                  <div><%= button_to "delete", task_path(task), method: :delete %></div>
15:                </div>
16:              <% end %>
17:            </div>
18:            <p class="mb-6 leading-relaxed">タスクを達成するたびに、推しから激励の言葉をもらえるタスク管理アプリです。</p>
19:          </div>
20:        </div>
21:      </div>
22:    </section>
  
